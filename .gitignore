node_modules/
**/node_modules/
.pnpm-store/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Build output and framework caches
.next/
**/.next/
.next-stale-*/
**/.next-stale-*/
dist/
**/dist/
build/
coverage/
*.tsbuildinfo

# Generated source
backend/src/generated/

