NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corestack
ACCESS_TOKEN_SECRET=change_me_change_me_change_me_change_me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_ACTIVE_SESSIONS=5
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# One-time SUPER_ADMIN bootstrap through a verified Google identity.
# Email is used only to bootstrap; subsequent authorization comes from UserRole.
SUPER_ADMIN_BOOTSTRAP_ENABLED=false
SUPER_ADMIN_BOOTSTRAP_PROVIDER=google
SUPER_ADMIN_GOOGLE_EMAILS=
SUPER_ADMIN_GOOGLE_SUBS=
SUPER_ADMIN_BOOTSTRAP_ONCE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@example.com
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FILE_MAX_SIZE_MB=20
FILE_ORPHAN_RETENTION_DAYS=10

# Legacy password bootstrap. Leave these empty when
# SUPER_ADMIN_BOOTSTRAP_ENABLED=true; Google bootstrap takes precedence.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
